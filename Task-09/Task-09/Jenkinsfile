pipeline {
    agent any

    environment {
        DOCKERHUB_USER = 'naren2026aws'
        IMAGE_NAME = 'task9-java-app'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('1. Checkout') {
            steps {
                echo 'Source code checked out from GitHub'
            }
        }

        stage('2. Maven Build') {
            steps {
                dir('Task-04') {
                    sh '''
                        export JAVA_HOME=/usr/lib/jvm/java-21-amazon-corretto.x86_64
                        export PATH=$JAVA_HOME/bin:$PATH
                        mvn -B clean package -DskipTests
                    '''
                }
            }
        }

        stage('3. Unit Test') {
            steps {
                dir('Task-04') {
                    sh '''
                        export JAVA_HOME=/usr/lib/jvm/java-21-amazon-corretto.x86_64
                        export PATH=$JAVA_HOME/bin:$PATH
                        mvn -B test
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'Task-04/target/surefire-reports/*.xml'
                }
            }
        }

        stage('4. SonarQube Analysis') {
            steps {
                dir('Task-04') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            export JAVA_HOME=/usr/lib/jvm/java-21-amazon-corretto.x86_64
                            export PATH=$JAVA_HOME/bin:$PATH
                            mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:5.3.0.6276:sonar \
                              -Dsonar.projectKey=task9-java-app \
                              -Dsonar.projectName=Task9-Java-App
                        '''
                    }
                }
            }
        }

        stage('5. Docker Build & Image Versioning') {
            steps {
                sh '''
                    docker build -t ${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG} Task-04
                    docker images ${DOCKERHUB_USER}/${IMAGE_NAME}
                '''
            }
        }

        stage('6. Push Image to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        echo "$DOCKER_TOKEN" | docker login \
                          -u "$DOCKER_USER" --password-stdin
                        docker push ${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG}
                        docker logout
                    '''
                }
            }
        }

        stage('7. Update Helm Configuration') {
            steps {
                sh '''
                    set -eu
                    test -f Task-09/deployment/values.yaml
                    sed -i -E \
                      "s/^([[:space:]]*tag:).*/\\1 \\"${IMAGE_TAG}\\"/" \
                      Task-09/deployment/values.yaml

                    echo "Updated Task-09 image configuration:"
                    cat Task-09/deployment/values.yaml
                '''
            }
        }

        stage('8. Commit Deployment Change') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-push-token',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        git config user.name "Jenkins Task9"
                        git config user.email "jenkins-task9@localhost"

                        cat > "$WORKSPACE/.git-askpass-task9.sh" <<'ASKPASS'
#!/bin/sh
case "$1" in
  *Username*) printf '%s\\n' "$GIT_USER" ;;
  *) printf '%s\\n' "$GIT_TOKEN" ;;
esac
ASKPASS
                        chmod 700 "$WORKSPACE/.git-askpass-task9.sh"
                        trap 'rm -f "$WORKSPACE/.git-askpass-task9.sh"' EXIT

                        git add -- Task-09/deployment/values.yaml
                        git diff --cached --check
                        git diff --cached -- Task-09/deployment/values.yaml

                        git commit -m "Task 9: update image tag to ${IMAGE_TAG}" \
                          -- Task-09/deployment/values.yaml

                        GIT_ASKPASS="$WORKSPACE/.git-askpass-task9.sh" \
                        GIT_TERMINAL_PROMPT=0 \
                          git push origin HEAD:main

                        echo "Task-09 deployment configuration committed and pushed."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Task 9 CI completed. Image: naren2026aws/task9-java-app:${BUILD_NUMBER}"
        }
        failure {
            echo 'Build failed. Check Console Output for the exact error.'
        }
    }
}
